# Names of the environment variables ytdlp-tool reads. Copy to .env (git-ignored) or set them in your shell.
# The CLI itself needs none of them. Never commit real values.

# Telegram bot (python -m ytdlp_tool.telegram_bot)
YTDL_TELEGRAM_BOT_TOKEN=        # bot token from @BotFather
YTDL_ALLOWED_CHAT_IDS=          # comma-separated chat IDs allowed to create jobs
YTDL_ALLOW_PUBLIC_BOT=          # set to 1 only to permit the "*" wildcard allowlist (not recommended)

# Digital Concert Hall jobs and native host
YTDLP_DCH_OUTPUT=               # download folder (default: output/chatgpt/digital-concert-hall)
YTDLP_DCH_STATE=                # job state and logs (default: %LOCALAPPDATA%\ytdlp-tool\dch)
YTDLP_DCH_EXTENSION_ORIGIN=     # override the accepted extension origin (tests only)
