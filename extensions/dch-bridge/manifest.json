{
  "manifest_version": 3,
  "name": "YTDLP Digital Concert Hall bridge",
  "version": "1.0.0",
  "description": "Gives the local ytdlp-tool host the signed-in Digital Concert Hall access token on request, so downloads can run on this computer. The token is never shown, copied or sent anywhere else.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.digitalconcerthall.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YTDLP Digital Concert Hall bridge"
  }
}
